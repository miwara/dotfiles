# ghosttyのシェル統合機能の個別機能を無効
# !不都合があったらここを変える!
shell-integration-features = false

term = xterm-256color

# フルスクリーン関連
#
# 全画面に引き伸ばした表示をしてほしいのに以下の場合だとwindowの大きさが変更される
# - ghosttyを全画面表示をしている状態で，他のアプリを起動すると
#   他のアプリのメニュー分ghosttyのwindowの高さが縮む
# - pcスリープから起動すると稀に全画面が解除されている
#
# 一旦メニューを表示しておく
# `window-padding-y`も一旦上方向のpaddingはしない
#fullscreen = non-native
fullscreen = non-native-visible-menu

# fullscreenの設定が優先される
#macos-non-native-fullscreen = true
#maximize = true
#macos-titlebar-style = tabs

# macos only
# altの特殊文字入力を無効
macos-option-as-alt = true

background = #2f3b33
background-opacity = 0.85
# 裏画面を見ながらコマンドを打ちたいのでblurはしない
# background-blur = false

# x軸方向　カンマ区切りで「右,左」の設定できる
window-padding-x = 10
# y軸方向　カンマ区切りで「上,下」の設定できる
# fullscreenが思ったように動かないので上方向のpaddingはしない
#window-padding-y = 30,5
window-padding-y = 5


cursor-style = block

# 11pt に設定(2px/pt)
font-size = 10

# 1 GiB = 1073741824 B
# 500 MiB = 524312500 B
scrollback-limit = 1073741824
scrollbar = never

# shift+enterで改行を入れられるようにする
keybind = shift+enter=text:\n

# ctrl+shift+upで文字サイズを大きく
# ctrl+shift+downで文字サイズを小さく
keybind = ctrl+shift+up=increase_font_size:0.5
keybind = ctrl+shift+down=decrease_font_size:0.5
